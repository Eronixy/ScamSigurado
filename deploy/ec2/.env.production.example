# Copy this file to .env.production on the EC2 instance. Never commit that file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://scamsigurado:REPLACE_WITH_URL_SAFE_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/scamsigurado?sslmode=require
ML_RUNTIME_URL=http://ml-runtime:8000
WEB_ORIGINS=https://REPLACE_WITH_YOUR_VERCEL_PROJECT.vercel.app
API_MAX_UPLOAD_BYTES=10485760
API_TEMP_DIR=/tmp/scamsigurado-api
ML_RUNTIME_TIMEOUT_SECONDS=90
RESULT_RETENTION_DAYS=30

ML_MODEL_DIR=/app/models
ML_TEMP_DIR=/tmp/scamsigurado-ml
ML_MAX_UPLOAD_BYTES=10485760
ML_MAX_IMAGE_PIXELS=25000000
ML_DEFAULT_TEXT_MODEL=rf
ML_DEFAULT_IMAGE_MODEL=vggnet
ML_DEFAULT_TEXT_WEIGHT=0.7
ML_DEFAULT_IMAGE_WEIGHT=0.3
ML_MODEL_VERSION=model-set-1-training-aligned-v2
